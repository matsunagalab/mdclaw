# MDClaw runtime for RIKYU (Linux arm64, CUDA 13) built from the pixi `cuda13`
# environment.
#
# One pixi.toml / pixi.lock for every image and workstation: OpenMM 8.6.1 and
# PyTorch 2.10.0 are conda-forge's CUDA 13 builds, openmm-torch (sm_100 +
# PythonTorchForce) and PLUMED 2.9.4 + openmm-plumed come from recipes/
# (pixi-build). Outside pixi, as in container/Dockerfile.pixi: the packmol-memgen
# fixes. RIKYU only: NVRTC 13.0 over the locked 13.1, the cuFFT FUSE shim, and
# the MODELLER ARM tarball (no conda package).
#
# Keep this file free of `RUN <<` heredocs: Podman 4.9 (RIKYU's login node) parses
# their lines as Dockerfile instructions.
#
#   container/scripts/build-rikyu-arm64.sh [--push] [--sif PATH]

ARG PIXI_IMAGE="ghcr.io/prefix-dev/pixi:0.83.0@sha256:3dce86c6e87371c58035aa41b09f2b56ca8f011722320551e0c2bfc1c59da5fb"
ARG CUDA_DEVEL_IMAGE="docker.io/nvidia/cuda:13.0.2-devel-ubuntu24.04@sha256:5dc1bca23d05bd37b011be68ec470c03b403a5da07ec3a86e41af9470e9d0cc6"
ARG CUDA_RUNTIME_IMAGE="docker.io/nvidia/cuda:13.0.2-runtime-ubuntu24.04@sha256:6a0e31b59e70890446f2c17356d6efc0d54260090a8c63d6ca7c2ad049db95d2"

# Stage 1: install the locked environment (builds the recipes once)
FROM --platform=linux/arm64 ${PIXI_IMAGE} AS build
ARG BUILD_JOBS="4"
# git fetches the recipe sources; gfortran/make rebuild PPM3; gcc builds the shim.
RUN test "$(dpkg --print-architecture)" = "arm64" && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates gcc gfortran git libc6-dev make && \
    rm -rf /var/lib/apt/lists/*
# The build machine has no GPU; declare the driver the environment's platform requires.
ENV CONDA_OVERRIDE_CUDA=13.0
# The environment is not relocatable: it keeps this path in the runtime stage.
WORKDIR /opt/mdclaw-src
COPY pixi.toml pixi.lock pyproject.toml README.md ./
COPY recipes/ recipes/
COPY mdclaw/ mdclaw/
# Keep only .pixi/envs: the recipe build trees are not part of the runtime.
RUN CPU_COUNT="${BUILD_JOBS}" pixi install -e cuda13 --locked && \
    find .pixi -mindepth 1 -maxdepth 1 ! -name envs -exec rm -rf {} + && \
    rm -rf recipes/*/.pixi /root/.cache
ENV MDCLAW_ENV=/opt/mdclaw-src/.pixi/envs/cuda13
# Replace the editable checkout with a regular install.
RUN $MDCLAW_ENV/bin/python -m pip install --no-cache-dir --no-deps --force-reinstall . && \
    rm -rf mdclaw build
# packmol-memgen's NumPy compatibility patch.
RUN SITE_PACKAGES=$($MDCLAW_ENV/bin/python -c "import site; print(site.getsitepackages()[0])") && \
    PATCH_FILE="$SITE_PACKAGES/packmol_memgen/lib/pdbremix/v3numpy.py" && \
    if [ -f "$PATCH_FILE" ]; then sed -i "s/np\.float)/float)/g; s/np\.int)/int)/g" "$PATCH_FILE"; fi
# Rebuild PPM3 (immers), the membrane orientation code bundled with packmol-memgen:
# opm.f has a FORMAT descriptor missing a comma (`f7.0''+-''`) that current
# gfortran rejects at runtime, so no oriented PDB is ever written. Running immers
# with empty stdin dies at the first read, before the bad FORMAT, so the stock
# binary is told apart by its compiled FORMAT string instead.
RUN PPM3_DIR=$($MDCLAW_ENV/bin/python -c "import packmol_memgen, pathlib; print(pathlib.Path(packmol_memgen.__file__).parent / 'lib' / 'ppm3')") && \
    sed -i "s/f7\.0''+-''/f7.0,''+-''/" "$PPM3_DIR/opm.f" && \
    grep -q "f7.0,''+-''" "$PPM3_DIR/opm.f" && \
    (make -C "$PPM3_DIR" clean >/dev/null 2>&1 || true) && \
    make -C "$PPM3_DIR" && \
    install -m 0755 "$PPM3_DIR/immers" "$MDCLAW_ENV/bin/immers" && \
    grep -a -q "f7.0,'+-'" "$MDCLAW_ENV/bin/immers" && \
    ! grep -a -q "f7.0'+-'" "$MDCLAW_ENV/bin/immers" && \
    "$MDCLAW_ENV/bin/immers" < /dev/null 2>&1 | grep -q "Fortran runtime error: End of file" && \
    rm -f datapar1 datapar2 datasub1
# MODELLER from the official tarball, as Linux ARM64 workstations install it. No
# license key is baked in. The script's import check needs the search path that
# pixi's activation supplies elsewhere.
COPY scripts/install-modeller-arm64.py /tmp/install-modeller-arm64.py
RUN LD_LIBRARY_PATH="$MDCLAW_ENV/lib/modeller-10.8/lib/armv8-gnu:$MDCLAW_ENV/lib" \
      $MDCLAW_ENV/bin/python /tmp/install-modeller-arm64.py && \
    rm /tmp/install-modeller-arm64.py
# Rootless runtimes can mount a SIF through FUSE. Pre-fault cuFFT's file-backed
# mappings so CUDA does not service FUSE page faults while creating FFT plans.
COPY container/mdclaw_fusefix.c /tmp/mdclaw_fusefix.c
RUN gcc -shared -fPIC -O2 -Wall -Wextra -Werror -Wl,-z,relro,-z,now \
      -o $MDCLAW_ENV/lib/libmdclaw_fusefix.so /tmp/mdclaw_fusefix.c -ldl && \
    rm /tmp/mdclaw_fusefix.c
# Copy the environment in several layers: a single multi-gigabyte blob is fragile
# through HPC registry proxies and Apptainer.
RUN mkdir /opt/mdclaw-layers && \
    mkdir -p $MDCLAW_ENV/targets && \
    mv $MDCLAW_ENV/lib/python3.12 /opt/mdclaw-layers/python3.12 && \
    mv $MDCLAW_ENV/lib /opt/mdclaw-layers/lib && \
    mv $MDCLAW_ENV/targets /opt/mdclaw-layers/targets

# Stage 2: NVIDIA's toolkit, for NVRTC 13.0 only
FROM --platform=linux/arm64 ${CUDA_DEVEL_IMAGE} AS cuda-devel

# Stage 3: slim CUDA 13.0 runtime
FROM --platform=linux/arm64 ${CUDA_RUNTIME_IMAGE}
ARG GIT_REVISION="unknown"
ARG WARM_MEMBRANE_CACHE="0"
LABEL org.opencontainers.image.title="MDClaw arm64 CUDA 13 runtime" \
      org.opencontainers.image.description="MDClaw Linux arm64 runtime built from the pixi cuda13 environment, with CUDA 13.0 NVRTC and CUDA 13.1 math libraries." \
      org.opencontainers.image.source="https://github.com/matsunagalab/mdclaw" \
      org.opencontainers.image.documentation="https://github.com/matsunagalab/mdclaw/blob/main/docs/developer/container.md" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.revision="${GIT_REVISION}" \
      org.opencontainers.image.vendor="matsunagalab" \
      com.nvidia.cuda.version="13.0.2" \
      io.mdclaw.cuda.math-libs.version="13.1" \
      io.mdclaw.cuda.cufft.minimum-version="12.1.0.78" \
      io.mdclaw.runtime.fuse-prefault="libcufft.so"
RUN test "$(dpkg --print-architecture)" = "arm64" && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates libgl1 libglib2.0-0 libsm6 libxrender1 && \
    rm -rf /var/lib/apt/lists/*
COPY --from=build /opt/mdclaw-src /opt/mdclaw-src
COPY --from=build /opt/mdclaw-layers/lib/ /opt/mdclaw-src/.pixi/envs/cuda13/lib/
COPY --from=build /opt/mdclaw-layers/python3.12/ /opt/mdclaw-src/.pixi/envs/cuda13/lib/python3.12/
COPY --from=build /opt/mdclaw-layers/targets/ /opt/mdclaw-src/.pixi/envs/cuda13/targets/
# OpenMM compiles kernels at Context creation, and a driver can reject PTX from a
# newer minor toolkit (CUDA_ERROR_UNSUPPORTED_PTX_VERSION). The lock holds NVRTC
# 13.1 (see feature.cuda13 in pixi.toml); this overlay keeps 13.0 ahead of it.
COPY --from=cuda-devel /usr/local/cuda/lib64/libnvrtc.so* /opt/mdclaw-src/.pixi/envs/cuda13/lib/
COPY --from=cuda-devel /usr/local/cuda/lib64/libnvrtc-builtins.so* /opt/mdclaw-src/.pixi/envs/cuda13/lib/
COPY container/scripts/test-gpu.py /opt/mdclaw-src/.pixi/envs/cuda13/share/mdclaw/test-gpu.py
RUN ln -s /opt/mdclaw-src/.pixi/envs/cuda13 /opt/mdclaw
ENV MDCLAW_CUDA_TOOLKIT_VERSION="13.0" \
    MDCLAW_CUDA_MATH_LIBS_VERSION="13.1" \
    MDCLAW_CUFFT_MIN_VERSION="12.1.0.78" \
    MDCLAW_MODELLER_VERSION="10.8" \
    MDCLAW_PPM3_PATCHED="1" \
    MDCLAW_PLUMED_VERSION="2.9.4" \
    MDCLAW_SST2_REVISION="3dc7013" \
    MDCLAW_PIXI_ENV="cuda13"
# The real path: /proc/self/maps, which the shim checks read, resolves the
# /opt/mdclaw symlink.
ENV MDCLAW_FUSEFIX_LIB="/opt/mdclaw-src/.pixi/envs/cuda13/lib/libmdclaw_fusefix.so" \
    LD_PRELOAD="/opt/mdclaw-src/.pixi/envs/cuda13/lib/libmdclaw_fusefix.so"
# The environment's activation, fixed (`singularity exec` runs no activation
# script). Text I/O in UTF-8 regardless of the locale: a GPU platform driver can
# reset the process locale to C while it initialises.
ENV CONDA_PREFIX="/opt/mdclaw" \
    PATH="/opt/mdclaw/bin:$PATH" \
    LD_LIBRARY_PATH="/opt/mdclaw/lib:/opt/mdclaw/lib/modeller-10.8/lib/armv8-gnu:/opt/mdclaw/lib/python3.12/site-packages/torch/lib:${LD_LIBRARY_PATH}" \
    AMBERHOME="/opt/mdclaw" \
    PERL5LIB="/opt/mdclaw/lib/perl/mm_pbsa" \
    GSETTINGS_SCHEMA_DIR="/opt/mdclaw/share/glib-2.0/schemas" \
    XML_CATALOG_FILES="file:///opt/mdclaw/etc/xml/catalog file:///etc/xml/catalog" \
    OPENMM_PLUGIN_DIR="/opt/mdclaw/lib/plugins" \
    PYTHONNOUSERSITE="1" \
    PYTHONUTF8="1" \
    NVIDIA_VISIBLE_DEVICES="all" \
    NVIDIA_DRIVER_CAPABILITIES="compute,utility" \
    MDCLAW_MEMBRANE_BUNDLED_CACHE_DIR="/opt/mdclaw/lib/python3.12/site-packages/mdclaw/data/membrane_patches"
# Build-time contracts. GPU acceptance runs from the resulting SIF because a
# container filesystem does not exercise the FUSE path.
COPY container/scripts/check-rikyu-image.py /opt/mdclaw-src/.pixi/envs/cuda13/share/mdclaw/check-rikyu-image.py
RUN /opt/mdclaw/bin/python /opt/mdclaw/share/mdclaw/check-rikyu-image.py
# The bundled patches ship in the package; regenerating them is a build-time gate
# for a release candidate only.
COPY scripts/warmup_membrane_cache.py /opt/mdclaw-src/.pixi/envs/cuda13/share/warmup_membrane_cache.py
RUN if [ "${WARM_MEMBRANE_CACHE}" = "1" ]; then \
      /opt/mdclaw/bin/python /opt/mdclaw/share/warmup_membrane_cache.py \
        --out "${MDCLAW_MEMBRANE_BUNDLED_CACHE_DIR}"; \
    fi
COPY container/scripts/entrypoint-pixi.sh /opt/mdclaw-src/.pixi/envs/cuda13/bin/entrypoint.sh
WORKDIR /work
ENTRYPOINT ["/opt/mdclaw/bin/entrypoint.sh"]
CMD ["mdclaw", "--version"]
