#!/usr/bin/env bash
# Select one scientific runtime; Slurm submission/control stays on the host.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
PKG_ROOT="${CLAUDE_PLUGIN_ROOT:-$REPO_ROOT}"
source "$PKG_ROOT/scripts/_internal/runtime.sh"

# Tools that run natively on the host (need sbatch/squeue/sinfo/sacct/scancel)
NATIVE_TOOLS="submit_job submit_array_job submit_mps_job check_job list_jobs cancel_job check_job_log inspect_cluster set_policy show_policy configure_container list_tracked_jobs"

# The tool name is the first argument that is neither an option nor the value
# of a global option, as in mdclaw/_cli.py::_detect_subcommand (keep
# GLOBAL_VALUE_OPTIONS in step with _GLOBAL_VALUE_OPTIONS there). Taking "$1"
# sent `mdclaw --output full list_tracked_jobs --sync` and
# `mdclaw --job-dir <jd> --node-id <id> submit_job ...` into the container,
# where no Slurm client exists.
GLOBAL_VALUE_OPTIONS="--job-dir --node-id --list-json --output --log-file --heartbeat-seconds"
TOOL=""
_skip_next=0
for _arg in "$@"; do
    if [ "$_skip_next" = 1 ]; then
        _skip_next=0
        continue
    fi
    case "$_arg" in
        -*)
            case "$_arg" in
                *=*) ;;
                *) if echo " $GLOBAL_VALUE_OPTIONS " | grep -q -- " $_arg "; then _skip_next=1; fi ;;
            esac
            ;;
        *)
            TOOL="$_arg"
            break
            ;;
    esac
done

# --- SLURM tools run natively (host python3 + host sbatch/squeue) ---
# run_rounds --executor mps drives Slurm jobs itself (submit_mps_job,
# check_job) and runs the policy through this launcher, so it is native too.
NATIVE_ROUNDS=""
if [ "$TOOL" = "run_rounds" ]; then
    case " $* " in
        *" --executor mps "*|*" --executor=mps "*) NATIVE_ROUNDS=1 ;;
    esac
fi
if [ -n "$TOOL" ] && { echo " $NATIVE_TOOLS " | grep -q -- " $TOOL " || [ -n "$NATIVE_ROUNDS" ]; }; then
    PYTHONPATH="${PKG_ROOT}${PYTHONPATH:+:$PYTHONPATH}" \
        exec python3 -m mdclaw._cli "$@"
fi

mdclaw_select_runtime
mdclaw_require_runtime
case "$RUNTIME" in
    pixi|conda) mdclaw_runtime_exec python -m mdclaw._cli "$@" ;;
    local) exec "$LOCAL_MDCLAW" "$@" ;;
    *) mdclaw_runtime_exec mdclaw "$@" ;;
esac
