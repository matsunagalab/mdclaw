  "schema_version": "1.0",
  "scoring": {
    "deterministic_checks": [
      {
        "check_id": "effect_direction_in_allowed_set",
        "check_type": "json_allowed_values",
        "json_file": "evidence_report.json",
        "json_path": "conclusion.direction",
        "allowed_values": [
          "destabilizing",
          "stabilizing",
          "neutral"
        ],
        "weight": 0.0
      },
      {
        "check_id": "paired_h124l_mutation",
        "check_type": "paired_mutation_topology",
        "topology_manifest_path": "outputs.topology.0",
        "mutant_topology_manifest_path": "outputs.topology.1",
        "wild_type_residue_name": "HIS",
        "required_residue_name": "LEU",
        "mutation_resseq": 124,
        "reference_changed_residue_heavy_atom_count": 10,
        "variant_changed_residue_heavy_atom_count": 8,
        "weight": 0.0
      }
    ],
    "ground_truth_checks": [
      {
        "check_id": "effect_direction_matches_truth",
        "truth_file": "truth/experimental_truth.json",
        "truth_path": "expected_direction",
        "submission_file": "evidence_report.json",
        "submission_path": "conclusion.direction",
        "weight": 1.0
      }
    ],
    "integrity_checks": [
      {
        "check_id": "evidence_report_real_bytes",
        "check_type": "artifact_min_bytes",
        "path": "evidence_report.json",
        "min_bytes": 400
      },
      {
        "check_id": "evidence_report_not_template",
        "check_type": "template_markers",
        "path": "evidence_report.json",
        "forbid_markers": [
          "Template placeholder",
          "Replace before scoring",
          "Replace with",
          "Generated by create_benchmark_submission_template",
          "fill task-specific"
        ]
      },
      {
        "check_id": "answer_evidence_complete",
        "check_type": "evidence_completeness",
        "required_keys": [
          "conclusion.direction",
          "conclusion.evidence_status",
          "conclusion.confidence",
          "evidence",
          "reasoning",
          "limitations"
        ]
      },
      {
        "check_id": "workflow_execution_recorded",
        "check_type": "provenance_execution_evidence",
        "min_command_count": 5,
        "require_harness_record": true,
        "required_stages": [
          "source",
          "prep",
          "prod",
          "analysis",
          "report"
        ]
      }
    ],
    "integrity_policy": "reject",
    "llm_judge_rubrics": [
      "reasoning_logic",
      "confidence_calibration",
      "overclaim_detection",
      "limitations"
    ]
  },
  "secondary_scores": [
    "evidence_communication"
  ],
  "task_id": "S03_stability_nuclease_h124l",
  "task_intent": "Open-planning scientific-answer test: determine the folding-stability direction of staphylococcal nuclease H124L relative to wild type at pH 5.5. The agent selects structural sources, sampling, replicas, and observables. A successful answer must be supported by the submitted MD evidence and match held-out experimental truth; prior knowledge is reported separately and cannot replace MD grounding.",
  "time_limit_minutes": 1440
}
