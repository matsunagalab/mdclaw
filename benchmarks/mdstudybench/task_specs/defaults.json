{
  "schema_version": "1.0",
  "description": "Shared defaults used to generate canonical MDStudyBench task.json files.",
  "task_defaults": {
    "schema_version": "1.0",
    "category": "experimental_ground_truth",
    "primary_score": "scientific_answer",
    "secondary_scores": [
      "evidence_communication"
    ],
    "evaluation_protocol": "grounded_correct_v2",
    "execution_mode": "lite",
    "time_limit_minutes": 1440,
    "failure_policy": {
      "blocked_by_missing_input_allowed": false,
      "insufficient_information_allowed": false
    }
  },
  "capability_tags": [
    "study_workflow"
  ],
  "required_outputs": [
    "manifest.json",
    "analysis_intent.json",
    "study_index.json",
    "evidence_report.json"
  ],
  "scoring_defaults": {
    "ground_truth_checks": [
      {
        "check_id": "md_outcome_matches_truth",
        "truth_file": "truth/experimental_truth.json",
        "truth_path": "expected_outcome",
        "submission_file": "evidence_report.json",
        "submission_path": "md_verdict.outcome",
        "weight": 1.0
      }
    ],
    "integrity_checks": [
      {
        "check_id": "evidence_report_real_bytes",
        "check_type": "artifact_min_bytes",
        "path": "evidence_report.json",
        "min_bytes": 400
      },
      {
        "check_id": "evidence_report_not_template",
        "check_type": "template_markers",
        "path": "evidence_report.json",
        "forbid_markers": [
          "Template placeholder",
          "Replace before scoring",
          "Replace with",
          "Generated by create_benchmark_submission_template",
          "fill task-specific"
        ]
      },
      {
        "check_id": "analysis_intent_real_bytes",
        "check_type": "artifact_min_bytes",
        "path": "analysis_intent.json",
        "min_bytes": 300
      },
      {
        "check_id": "analysis_intent_not_template",
        "check_type": "template_markers",
        "path": "analysis_intent.json",
        "forbid_markers": [
          "Template placeholder",
          "Replace before scoring",
          "Replace with",
          "fill task-specific"
        ]
      },
      {
        "check_id": "answer_evidence_complete",
        "check_type": "evidence_completeness",
        "required_keys": [
          "md_verdict.status",
          "md_verdict.basis",
          "md_verdict.confidence",
          "md_verdict.cited_evidence_ids",
          "prior_expectation",
          "evidence",
          "reasoning",
          "limitations"
        ]
      }
    ],
    "integrity_policy": "reject"
  }
}
