{
  "$defs": {
    "CheckResult": {
      "properties": {
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "check_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Check Type"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "weight": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "check_id",
        "passed",
        "score"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "LLMJudgeResult": {
      "properties": {
        "abstention_justified": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Abstention Justified"
        },
        "abstention_reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Abstention Reason Codes",
          "type": "array"
        },
        "cited_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Cited Evidence Ids",
          "type": "array"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "evidence_packet_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Packet Hash"
        },
        "judge_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Judge Model"
        },
        "logical_grounding_supported": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logical Grounding Supported"
        },
        "prompt_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Hash"
        },
        "rationale": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Rationale",
          "type": "object"
        },
        "raw_response_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Response File"
        },
        "rubric_version": {
          "default": "1.0",
          "title": "Rubric Version",
          "type": "string"
        },
        "scores": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Scores",
          "type": "object"
        },
        "support_verdict": {
          "anyOf": [
            {
              "enum": [
                "supported",
                "inconclusive",
                "contradicted"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Support Verdict"
        },
        "temperature": {
          "default": 0.0,
          "title": "Temperature",
          "type": "number"
        },
        "violations": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Violations",
          "type": "array"
        }
      },
      "title": "LLMJudgeResult",
      "type": "object"
    },
    "RuntimeRecord": {
      "properties": {
        "gpu_hours": {
          "default": 0.0,
          "title": "Gpu Hours",
          "type": "number"
        },
        "tokens": {
          "default": 0,
          "title": "Tokens",
          "type": "integer"
        },
        "walltime_minutes": {
          "default": 0.0,
          "title": "Walltime Minutes",
          "type": "number"
        }
      },
      "title": "RuntimeRecord",
      "type": "object"
    },
    "StudyVerdict": {
      "description": "Conjunctive outcome for the grounded-correct Study protocol.",
      "properties": {
        "decision_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Decision Reasons",
          "type": "array"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "evaluation_complete": {
          "default": false,
          "title": "Evaluation Complete",
          "type": "boolean"
        },
        "evidence_packet_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Packet Hash"
        },
        "evidence_status": {
          "anyOf": [
            {
              "enum": [
                "supported",
                "inconclusive",
                "contradicted"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Status"
        },
        "evidence_verified": {
          "default": false,
          "title": "Evidence Verified",
          "type": "boolean"
        },
        "grounded_correct": {
          "default": false,
          "title": "Grounded Correct",
          "type": "boolean"
        },
        "reasoning_grounded": {
          "default": false,
          "title": "Reasoning Grounded",
          "type": "boolean"
        },
        "truth_correct": {
          "default": false,
          "title": "Truth Correct",
          "type": "boolean"
        },
        "valid_md": {
          "default": false,
          "title": "Valid Md",
          "type": "boolean"
        }
      },
      "title": "StudyVerdict",
      "type": "object"
    },
    "StudyVerdictV2": {
      "additionalProperties": false,
      "description": "The three non-compensating MDStudyBench v2 evaluation gates.",
      "properties": {
        "analysis_intent_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Analysis Intent Hash"
        },
        "claim_supported": {
          "default": false,
          "title": "Claim Supported",
          "type": "boolean"
        },
        "decision_reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Decision Reason Codes",
          "type": "array"
        },
        "diagnostics": {
          "additionalProperties": true,
          "title": "Diagnostics",
          "type": "object"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "evaluation_complete": {
          "default": false,
          "title": "Evaluation Complete",
          "type": "boolean"
        },
        "evidence_packet_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Packet Hash"
        },
        "grounded_correct": {
          "default": false,
          "title": "Grounded Correct",
          "type": "boolean"
        },
        "result_class": {
          "default": "not_evaluated",
          "enum": [
            "not_evaluated",
            "grounded_correct",
            "grounded_wrong",
            "unsupported_claim",
            "unresolved",
            "invalid_execution"
          ],
          "title": "Result Class",
          "type": "string"
        },
        "truth_agreement": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Truth Agreement"
        },
        "truth_available": {
          "default": false,
          "title": "Truth Available",
          "type": "boolean"
        },
        "valid_execution": {
          "default": false,
          "title": "Valid Execution",
          "type": "boolean"
        }
      },
      "title": "StudyVerdictV2",
      "type": "object"
    }
  },
  "properties": {
    "capability_scores": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Capability Scores",
      "type": "object"
    },
    "deterministic_checks": {
      "items": {
        "$ref": "#/$defs/CheckResult"
      },
      "title": "Deterministic Checks",
      "type": "array"
    },
    "errors": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Errors",
      "type": "array"
    },
    "ground_truth_checks": {
      "items": {
        "$ref": "#/$defs/CheckResult"
      },
      "title": "Ground Truth Checks",
      "type": "array"
    },
    "integrity_warnings": {
      "items": {
        "type": "string"
      },
      "title": "Integrity Warnings",
      "type": "array"
    },
    "llm_judge": {
      "$ref": "#/$defs/LLMJudgeResult"
    },
    "primary_score": {
      "enum": [
        "preparation",
        "execution",
        "scientific_answer",
        "evidence_communication"
      ],
      "title": "Primary Score",
      "type": "string"
    },
    "run_id": {
      "default": "",
      "title": "Run Id",
      "type": "string"
    },
    "runtime": {
      "$ref": "#/$defs/RuntimeRecord"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scores": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Scores",
      "type": "object"
    },
    "status": {
      "enum": [
        "passed",
        "partial",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "study_verdict": {
      "anyOf": [
        {
          "$ref": "#/$defs/StudyVerdictV2"
        },
        {
          "$ref": "#/$defs/StudyVerdict"
        }
      ],
      "title": "Study Verdict"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "weighted_total": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Weighted Total",
      "type": "number"
    }
  },
  "required": [
    "task_id",
    "primary_score",
    "status",
    "weighted_total"
  ],
  "title": "Score",
  "type": "object"
}
